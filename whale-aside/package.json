{
  "name": "@local/dsh-whale-aside",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "鲸鱼娘小独白：whale-girl persona + whale_aside tool + 情绪贴图气泡 + 可自定义音色的 Edge TTS 语音.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
